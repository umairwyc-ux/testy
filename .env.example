# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://marketystudio.com"

# SESSION_SECRET: Secret key used by the backend server to sign authentication tokens.
SESSION_SECRET="replace-with-secure-64-char-random-hex-secret"

# ADMIN_EMAIL & ADMIN_PASSWORD_HASH: Initial administrator bootstrap credentials (never exposed to client).
ADMIN_EMAIL="admin@marketystudio.com"
ADMIN_INITIAL_PASSWORD="replace-with-strong-admin-password"

# SUPABASE / POSTGRESQL CONFIGURATION (Optional external persistence override)
DATABASE_URL="postgresql://user:password@localhost:5432/markety_studio"
PRIVATE_STORAGE_BUCKET="markety-studio-deliverables"

# EXCHANGE RATE CONFIGURATION
DEFAULT_USD_TO_PKR_RATE="278.50"

